OPENAI_API_KEY=

# Optional. Adds a local cross-encoder rerank stage to retrieval (no extra
# API key, but pulls in a heavy torch/sentence-transformers dependency).
# Off by default: the eval suite showed no net improvement over plain
# adaptive top-k (11.5/15 vs 12.0/15) -- see README "Eval results" for why.
# SKIM_ENABLE_RERANK=true
